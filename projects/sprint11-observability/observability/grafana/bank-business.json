    {
      "type": "stat",
      "title": "Failed withdrawals (range)",
      "description": "Counters bank_cash_withdrawal_failures_total, bank_transfer_failures_total and bank_notification_failures_total are registered on the first failure, so 'no failures counted' is the normal empty state, not missing telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(((increase(bank_cash_withdrawal_failures_total[$__range]) and bank_cash_withdrawal_failures_total offset $__range) or bank_cash_withdrawal_failures_total))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
