<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="007-order-products" author="principalwater">
        <preConditions onFail="HALT"><not><tableExists tableName="order_products"/></not></preConditions>
        <createTable tableName="order_products">
            <column name="order_id" type="bigint"><constraints nullable="false" foreignKeyName="fk_order_products_order" references="orders(id)"/></column>
            <column name="product_id" type="bigint"><constraints nullable="false" foreignKeyName="fk_order_products_product" references="products(id)"/></column>
        </createTable>
        <rollback><dropTable tableName="order_products"/></rollback>
    </changeSet>
</databaseChangeLog>
