{
  "realm": "study",
  "enabled": true,
  "sslRequired": "none",
  "clients": [{
    "clientId": "study-login",
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "${COURSE_CLIENT_SECRET}",
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "implicitFlowEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["http://127.0.0.1:18180/login/oauth2/code/keycloak"],
    "attributes": {"pkce.code.challenge.method": "S256"},
    "defaultClientScopes": ["profile", "email", "roles"]
  }],
  "users": [{
    "username": "alice",
    "firstName": "Alice",
    "lastName": "Example",
    "email": "alice@example.invalid",
    "emailVerified": true,
    "enabled": true,
    "credentials": [{"type": "password", "value": "${COURSE_USER_PASSWORD}", "temporary": false}]
  }]
}
