        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (service) (jvm_memory_used_bytes{job=~\"bank-(web|worker)\", service=~\"$service\", area=\"heap\", id=~\"G1 Old Gen|Tenured Gen|PS Old Gen\"} / (jvm_memory_max_bytes{job=~\"bank-(web|worker)\", service=~\"$service\", area=\"heap\", id=~\"G1 Old Gen|Tenured Gen|PS Old Gen\"} > 0))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
