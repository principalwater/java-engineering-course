    {
      "type": "timeseries",
      "title": "p95 request latency by service",
      "description": "Needs histogram buckets on http.server.requests (management.metrics.distribution.slo.http.server.requests); alert BankHttpLatencyP95High fires above 1s.",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{job=\"bank-web\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
