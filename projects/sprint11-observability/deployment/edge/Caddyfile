        header_up -traceparent
        header_up -tracestate
        header_up -b3
        header_up -X-B3-*
        header_up -Forwarded
        header_up -X-Forwarded-Prefix
        header_up X-Forwarded-Host auth-bank.valgrind-home.localhost:8460
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 8460
    }
}

