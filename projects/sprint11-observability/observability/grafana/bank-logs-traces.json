{
  "uid": "bank-logs-traces",
  "title": "Bank11 / Logs and traces",
  "description": "Search redacted JSON logs; every traceId links to its Zipkin trace and back.",
  "tags": [
    "bank11",
    "logs",
    "traces"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Bank11 dashboards",
      "tags": [
        "bank11"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "query",
        "label": "Lucene query",
        "type": "textbox",
        "query": "level:ERROR",
        "current": {
          "text": "level:ERROR",
          "value": "level:ERROR"
        },
        "options": [
          {
            "selected": true,
            "text": "level:ERROR",
            "value": "level:ERROR"
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Log events",
      "datasource": {
        "type": "elasticsearch",
        "uid": "bank-logs"
      },
      "description": "Click a log line, then the traceId field's Zipkin link (a datasource data link) to open the trace in Explore. Try: traceId:\"<id>\" or service:accounts AND level:ERROR.",
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "bank-logs"
          },
          "timeField": "@timestamp",
          "refId": "A",
          "query": "$query",
          "metrics": [
            {
              "id": "1",
              "type": "logs",
              "settings": {
                "limit": "100"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 1,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Events by level",
      "datasource": {
        "type": "elasticsearch",
        "uid": "bank-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "bank-logs"
          },
          "timeField": "@timestamp",
          "refId": "A",
          "query": "$query",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "level",
              "settings": {
                "size": "6",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "bargauge",
      "title": "Events by service",
      "datasource": {
        "type": "elasticsearch",
        "uid": "bank-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch",
            "uid": "bank-logs"
          },
          "timeField": "@timestamp",
          "refId": "A",
          "query": "$query",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      }
    }
  ]
}
