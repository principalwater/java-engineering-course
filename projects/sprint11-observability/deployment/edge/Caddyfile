# Наблюдаемость отделена от клиентского кабинета: собственные read-only учётные записи операторов.
https://grafana-bank.valgrind-home.localhost:8460 {
    tls /run/secrets/tls_certificate.pem /run/secrets/tls_private_key.pem
    header Alt-Svc clear
    @management path /metrics /api/admin/*
    respond @management 404
    reverse_proxy grafana:3000 {
        header_up -Forwarded
        header_up -X-Forwarded-Prefix
        header_up X-Forwarded-Host grafana-bank.valgrind-home.localhost:8460
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 8460
    }
}

