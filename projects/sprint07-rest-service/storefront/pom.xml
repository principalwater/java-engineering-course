<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>dev.principalwater</groupId><artifactId>rest-storefront</artifactId><version>1.0.0</version></parent>
    <artifactId>storefront</artifactId>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-thymeleaf</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis-reactive</artifactId></dependency>
        <dependency><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId></dependency>
    </dependencies>
    <build>
        <finalName>storefront</finalName>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.openapitools</groupId><artifactId>openapi-generator-maven-plugin</artifactId>
                <configuration>
                    <generatorName>java</generatorName><library>webclient</library>
                    <apiPackage>dev.principalwater.store.payment.generated.api</apiPackage>
                    <modelPackage>dev.principalwater.store.payment.generated.model</modelPackage>
                    <invokerPackage>dev.principalwater.store.payment.generated.client</invokerPackage>
                    <configOptions>
                        <useJakartaEe>true</useJakartaEe><openApiNullable>false</openApiNullable>
                        <useBeanValidation>true</useBeanValidation><dateLibrary>java8</dateLibrary>
                        <hideGenerationTimestamp>true</hideGenerationTimestamp>
                    </configOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/AnalyticsIntegrationTest.java</exclude>
                        <exclude>**/ClickHouseClusterTest.java</exclude>
                        <exclude>**/CatalogCacheIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
