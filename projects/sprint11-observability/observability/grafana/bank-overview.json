    {
      "type": "timeseries",
      "title": "5xx share of requests",
      "description": "Alert BankHttpServerErrorRatioHigh fires above 5% for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "bank-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bank-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"bank-web\", status=~\"5..\", uri!~\"/actuator.*\"}[$__rate_interval])) / sum by (service) (rate(http_server_requests_seconds_count{job=\"bank-web\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
